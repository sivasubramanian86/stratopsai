# Development Environment Configuration
ENVIRONMENT=dev
AWS_REGION=us-east-1

# Stack Names
INFRA_STACK_NAME=stratopsai-infrastructure-dev
AI_CORE_STACK_NAME=stratopsai-ai-core-dev

# SageMaker Configuration
SAGEMAKER_INSTANCE_TYPE=ml.t2.medium
SAGEMAKER_INSTANCE_COUNT=1

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MAX_TOKENS=300

# API Configuration
API_STAGE=dev
CORS_ENABLED=true

# Monitoring
LOG_LEVEL=INFO
ENABLE_XRAY_TRACING=false

# Resource Limits
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY=512

# Data Configuration
KINESIS_SHARD_COUNT=1
S3_VERSIONING_ENABLED=true