# Production Environment Configuration
ENVIRONMENT=prod
AWS_REGION=us-east-1

# Stack Names
INFRA_STACK_NAME=stratopsai-infrastructure-prod
AI_CORE_STACK_NAME=stratopsai-ai-core-prod

# SageMaker Configuration
SAGEMAKER_INSTANCE_TYPE=ml.m5.large
SAGEMAKER_INSTANCE_COUNT=2

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MAX_TOKENS=500

# API Configuration
API_STAGE=prod
CORS_ENABLED=false

# Monitoring
LOG_LEVEL=WARN
ENABLE_XRAY_TRACING=true

# Resource Limits
LAMBDA_TIMEOUT=60
LAMBDA_MEMORY=1024

# Data Configuration
KINESIS_SHARD_COUNT=3
S3_VERSIONING_ENABLED=true

# Security
ENABLE_WAF=true
ENABLE_API_KEY=true